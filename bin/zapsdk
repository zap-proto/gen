#!/usr/bin/env bash
# zapsdk — the one and only way to generate a Hanzo client SDK from a .zap
# schema. ZAP-native (primary) + OpenAPI HTTP/WS/SSE (fallback), from one
# schema, per language. See ../README.md (ADR-0001).
#
#   zapsdk <lang> <schema.zap>   # one language
#   zapsdk all                   # every language x every schema in ./schemas
#
# lang ∈ { go rust python ts cpp ruby php }
set -euo pipefail

GEN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ZAP_JS="${ZAP_JS:-$(cd "$GEN_DIR/../js" && pwd)}"
OUT="${OUT:-$GEN_DIR/out}"
HDR="// Code generated by zap-proto/gen (zapgen) from a .zap schema. DO NOT EDIT."
REGEN="// Regenerate: zap-proto/gen/bin/zapsdk %s %s"

log() { printf 'zapsdk: %s\n' "$*" >&2; }
die() { printf 'zapsdk: error: %s\n' "$*" >&2; exit 1; }

# Build/locate the canonical TS zapgen (dependency-free core; node builtins).
zapgen() {
  local built="$ZAP_JS/dist/bin/zapgen.js"
  if [ ! -f "$built" ]; then
    log "building zapgen in $ZAP_JS (one-time)"
    ( cd "$ZAP_JS" && { [ -d node_modules ] || pnpm install --frozen-lockfile 2>/dev/null || pnpm install; } && pnpm build )
  fi
  node "$built" "$@"
}

emit_native() { # <lang> <schema> <outdir>
  local lang="$1" schema="$2" outdir="$3"
  case "$lang" in
    ts)
      zapgen --emit=ts,openapi -out "$outdir" "$schema"
      ;;
    go)
      # canonical Go zapgen (github.com/zap-proto/go/cmd/zapgen) once vendored;
      # until then emit OpenAPI and generate the Go HTTP-fallback client.
      zapgen --emit=openapi -out "$outdir" "$schema"
      log "go: ZAP-native emit backend pending (Go zapgen); OpenAPI emitted"
      ;;
    python|rust|cpp|ruby)
      # emit-<lang> backend pending in zapgen; emit OpenAPI as the contract for
      # the HTTP-fallback client (openapi-python-client/progenitor/openapi-gen).
      zapgen --emit=openapi -out "$outdir" "$schema"
      log "$lang: ZAP-native emit backend pending; OpenAPI emitted (fallback client)"
      ;;
    php)
      zapgen --emit=openapi -out "$outdir" "$schema"
      log "php: fallback-only (no zap-proto/php runtime yet); OpenAPI emitted"
      ;;
    *) die "unknown lang '$lang' (go rust python ts cpp ruby php)" ;;
  esac
}

# emit_docs writes the per-language SDK docs into the hanzo-docs reserved slot
# content/docs/sdks/<lang>/ (gitignored there — regenerate, never hand-edit).
# Scope: usage/quickstart/typed-client + transport selection only; it LINKS to
# the canonical API reference (generated from hanzoai/openapi) and never
# re-lists endpoints. Default target: out/docs/<lang> unless DOCS_ROOT points at
# a hanzo-docs .../content/docs/sdks checkout.
emit_docs() { # <lang> <schema> <service>
  local lang="$1" schema="$2" svc="$3"
  local docdir="${DOCS_ROOT:-$OUT/docs}/$lang"
  mkdir -p "$docdir"
  {
    printf -- '---\ntitle: %s SDK\ndescription: Generated ZAP SDK — quickstart and typed-client usage.\n---\n\n' "$lang"
    printf '{/* Generated by zap-proto/gen from %s. DO NOT EDIT — regenerate: bin/zapsdk %s %s */}\n\n' "$(basename "$schema")" "$lang" "$schema"
    printf '# %s SDK\n\nZAP-native transport is primary; HTTPS/WS/SSE is the fallback. Install, construct the client, pick a transport, call a method. For the full endpoint reference see the [canonical API reference](/docs/api) — this page does not re-list endpoints.\n' "$lang"
  } > "$docdir/${svc}.mdx"
  log "docs $lang <- $svc -> $docdir/${svc}.mdx"
}

one() { # <lang> <schema>
  local lang="$1" schema="$2"
  [ -f "$schema" ] || die "schema not found: $schema"
  local base outdir; base="$(basename "$schema" .zap)"; outdir="$OUT/$lang/$base"
  mkdir -p "$outdir"
  log "generate $lang <- $schema  ->  $outdir"
  emit_native "$lang" "$schema" "$outdir"
  emit_docs "$lang" "$schema" "$base"
  log "done $lang/$base"
}

main() {
  [ $# -ge 1 ] || die "usage: zapsdk <lang> <schema.zap> | zapsdk all"
  if [ "$1" = "all" ]; then
    for lang in go rust python ts cpp ruby php; do
      for s in "$GEN_DIR"/schemas/*.zap; do one "$lang" "$s"; done
    done
    return
  fi
  [ $# -eq 2 ] || die "usage: zapsdk <lang> <schema.zap>"
  one "$1" "$2"
}
main "$@"
